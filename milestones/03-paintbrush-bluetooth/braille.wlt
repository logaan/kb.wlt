Def union-bit Fn {a: u16 b: u16 bit: s64}
  If eq(rem(div(to-s64(a) bit) 2) 1) bit
    If eq(rem(div(to-s64(b) bit) 2) 1) bit 0

Def union Fn {a: u16 b: u16}
  to-u16(add(add(add(add(add(add(add(add(union-bit(a b 1) union-bit(a b 2)) union-bit(a b 4)) union-bit(a b 8)) union-bit(a b 16)) union-bit(a b 32)) union-bit(a b 64)) union-bit(a b 128)) union-bit(a b 256)))

Export {iface: "kb:firmware/braille@0.1.0" name: step params: {state: state keys: u16} result: output}
Def step Fn {state: state keys: u16}
  Match state [
    ({held: held chord: chord}
      If eq(keys 0)
        Let {packed: If eq(held 0) The u32 0 map-cell(chord)}
          {state: {held: The u16 0 chord: The u16 0}
           usage: to-u8(rem(packed 256)) modifiers: to-u8(div(packed 256))}
        {state: {held: keys chord: If eq(held 0) keys union(chord keys)}
         usage: The u8 0 modifiers: The u8 0})]
