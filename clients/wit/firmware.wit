package kb:firmware@0.1.0;

interface keyboard {
    enum key-state {
        pressed,
        released,
    }

    record key-event {
        position: u16,
        state: key-state,
        timestamp-ms: u32,
    }

    record key {
        usage: u16,
        modifiers: u8,
    }

    variant action {
        press(key),
        release(key),
        tap(key),
        release-all,
    }

    record input {
        events: list<key-event>,
        now-ms: u32,
    }

    record output {
        state: list<u8>,
        events: list<key-event>,
        actions: list<action>,
        wake-at-ms: option<u32>,
    }

    process: func(state: list<u8>, input: input) -> output;
    transform-output: func(state: list<u8>, actions: list<action>) -> tuple<list<u8>, list<action>>;
}

interface braille {
    enum action-kind {
        idle,
        tap,
        sticky,
    }

    record state {
        held: u16,
        chord: u16,
    }

    record output {
        state: state,
        usage: u8,
        modifiers: u8,
        consumer: u16,
        kind: action-kind,
    }

    step: func(state: state, keys: u16) -> output;
    map-cell: func(cell: u16) -> u32;
}

world braille-module {
    export braille;
}

world keyboard-module {
    export keyboard;
}

interface display {
    record command {
        opcode: u8,
        x: u16,
        y: u16,
        w: u16,
        h: u16,
        first: u8,
        second: u8,
        third: u8,
    }

    render: func(width: u16, height: u16, model: list<u8>, detail: string) -> tuple<list<command>, list<string>>;
    record viewport {
        width: u16,
        height: u16,
        host-switch: bool,
    }

    navigate: func(screen: u8, selected: u16, cell: u16, view: viewport) -> u32;

    enum navigation {
        up,
        down,
        left,
        right,
        enter,
        escape,
    }

    navigate-action: func(screen: u8, selected: u16, action: navigation, view: viewport) -> u32;
}

world keyboard-display {
    export keyboard;
    export braille;
    export display;
}

world braille-display {
    export braille;
    export display;
}
